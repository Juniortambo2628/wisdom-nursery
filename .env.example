# Wisdom Propagation Nursery. Copy to .env (locally) or to <DEPLOY_PATH>/shared/.env (server).
# Never commit real values.

APP_NAME="Wisdom Propagation Nursery"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Nairobi
APP_URL=https://nursery.wisdomcapital.co.ke

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=wn_

# Server SMTP (cPanel email account)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="orders@nursery.wisdomcapital.co.ke"
MAIL_FROM_NAME="${APP_NAME}"

# --- Wisdom Propagation Nursery -------------------------------------------------------
# Public WhatsApp number for wa.me links, format 2547XXXXXXXX ({{NURSERY_WHATSAPP}})
NURSERY_WHATSAPP=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX (empty = no tracking)
GA4_MEASUREMENT_ID=
# Secret path segment for the M-Pesa callback URL (long random string)
MPESA_CALLBACK_SECRET=

# --- M-Pesa (Safaricom Daraja) --------------------------------------------
# sandbox | production
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Business short code used for the STK password (paybill number, or the till's store/head-office number)
MPESA_SHORTCODE=174379
# paybill -> CustomerPayBillOnline, till -> CustomerBuyGoodsOnline
MPESA_TYPE=paybill
# Till number customers pay to ({{TILL}}); for paybill leave equal to MPESA_SHORTCODE
MPESA_PARTY_B=174379
MPESA_PASSKEY=
MPESA_ACCOUNT_REFERENCE="WisdomNursery"

# --- SMS (Africa's Talking) -----------------------------------------------
# sandbox | production
AT_ENV=sandbox
AT_USERNAME=sandbox
AT_API_KEY=
# Approved alphanumeric sender ID; empty = shared short code
AT_SENDER_ID=

# --- WhatsApp alerts ------------------------------------------------------
# log | cloud   (log = write to notification_logs only, until Meta approves the template)
WHATSAPP_DRIVER=log
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_ORDER=new_order_alert
WHATSAPP_TEMPLATE_QUOTE=new_quote_alert
WHATSAPP_TEMPLATE_LANG=en

# --- Backups --------------------------------------------------------------
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFY_EMAIL=

VITE_APP_NAME="${APP_NAME}"
